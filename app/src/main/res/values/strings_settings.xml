<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================== -->
    <!-- Preference keys.                                                   -->
    <!--                                                                    -->
    <!-- Every value MUST stay identical to the matching Prefs.KEY_*        -->
    <!-- constant in com.nimbus.browser.core.Prefs, because both the XML   -->
    <!-- PreferenceManager and the app code read/write the very same        -->
    <!-- SharedPreferences file (Prefs.FILE).                               -->
    <!--                                                                    -->
    <!-- Keys declared as @string resources (instead of literal text) are   -->
    <!-- required for ListPreference/Preference keys so that the key and   -->
    <!-- the human readable label can never drift apart.                    -->
    <!-- ================================================================== -->

    <string name="PREF_KEY_THEME" translatable="false">pref_theme</string>
    <string name="PREF_KEY_SEARCH_ENGINE" translatable="false">pref_search_engine</string>
    <string name="PREF_KEY_DESKTOP_SITE" translatable="false">pref_desktop_site</string>
    <string name="PREF_KEY_FULLSCREEN" translatable="false">pref_fullscreen</string>
    <string name="PREF_KEY_START_PAGE_SEARCH" translatable="false">pref_start_page_search</string>
    <string name="PREF_KEY_SHOW_SHORTCUTS" translatable="false">pref_show_shortcuts</string>
    <string name="PREF_KEY_SHOW_FREQUENT" translatable="false">pref_show_frequent</string>
    <string name="PREF_KEY_SHOW_RECENT" translatable="false">pref_show_recent</string>
    <string name="PREF_KEY_DEFAULT_PRIVATE" translatable="false">pref_default_private</string>
    <string name="PREF_KEY_OPEN_IN_BACKGROUND" translatable="false">pref_open_in_background</string>
    <string name="PREF_KEY_TEXT_ZOOM" translatable="false">pref_text_zoom</string>
    <string name="PREF_KEY_CLOSE_TABS_ON_EXIT" translatable="false">pref_close_tabs_on_exit</string>
    <string name="PREF_KEY_WEB_CACHE" translatable="false">pref_web_cache</string>
    <string name="PREF_KEY_BLOCK_THIRD_PARTY" translatable="false">pref_block_third_party</string>
    <string name="PREF_KEY_SEEDED_SHORTCUTS" translatable="false">pref_seeded_shortcuts</string>

    <!-- Action preferences (no Prefs.KEY_* counterpart) -->
    <string name="PREF_KEY_CLEAR_DATA" translatable="false">pref_clear_browsing_data</string>
    <string name="PREF_KEY_OPEN_DOWNLOADS" translatable="false">pref_open_downloads</string>
    <string name="PREF_KEY_RESET_SHORTCUTS" translatable="false">pref_reset_shortcuts</string>
    <string name="PREF_KEY_ABOUT" translatable="false">pref_about</string>

    <!-- ================================================================== -->
    <!-- Entry-value arrays for the two index based ListPreferences.         -->
    <!--                                                                    -->
    <!-- res/values/arrays.xml is owned by another module and only ships    -->
    <!-- the *labels* (theme_entries, web_cache_entries, text_zoom_...).    -->
    <!-- Prefs however stores text zoom and web cache mode as Ints, so the  -->
    <!-- widgets need "0,1,2..." entry values that can be parsed back into   -->
    <!-- an index.                                                          -->
    <!-- ================================================================== -->
    <string-array name="text_zoom_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>

    <string-array name="web_cache_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>

