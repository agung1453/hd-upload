<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared chrome for the two flat list screens (history, bookmarks).

    Both activities inflate this same layout through ActivityListScreenBinding,
    then wire their own adapter, empty-state copy and toolbar action. The
    toolbar has three optional slots - back (always on), a search field that
    slides in on demand, and a single contextual action - so the screens stay
    visually identical and only differ in content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- ===================== Top bar ===================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/bg_surface"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Nimbus.ToolbarIconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/TextAppearance.Nimbus.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            tools:text="History" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:hint="@string/history_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:text="example.com"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/Widget.Nimbus.ToolbarIconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_history_search"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnAction"
            style="@style/Widget.Nimbus.ToolbarIconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_clear"
            android:scaleType="centerInside"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:tint="@color/text_secondary"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- ===================== List ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l"
        android:scrollbars="vertical"
        tools:itemCount="6"
        tools:listitem="@layout/item_history" />

    <!-- ===================== Empty state ===================== -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imgEmpty"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_globe"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/txtEmptyTitle"
            style="@style/TextAppearance.Nimbus.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:textColor="@color/text_primary"
            tools:text="No history yet" />

        <TextView
            android:id="@+id/txtEmptyBody"
            style="@style/TextAppearance.Nimbus.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            tools:text="Pages you visit will appear here." />

    </LinearLayout>

</LinearLayout>