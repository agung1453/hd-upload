<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m">

        <ImageButton
            android:id="@+id/btnDone"
            style="@style/Widget.Nimbus.ToolbarIconButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_done"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/TextAppearance.Nimbus.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/title_tabs" />

        <TextView
            android:id="@+id/btnCloseAll"
            style="@style/Widget.Nimbus.Button.Text.Toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabs_close_all" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/separator" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_m"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/cd_tab_preview"
                android:src="@drawable/ic_tabs"
                android:tint="@color/text_tertiary" />

            <TextView
                style="@style/TextAppearance.Nimbus.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/tabs_empty_title" />

            <TextView
                style="@style/TextAppearance.Nimbus.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/tabs_empty_body" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/separator" />

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <LinearLayout
            android:id="@+id/btnNewTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s">

            <ImageView
                android:layout_width="@dimen/bottom_icon_size"
                android:layout_height="@dimen/bottom_icon_size"
                android:contentDescription="@string/action_new_tab"
                android:src="@drawable/ic_add"
                android:tint="@color/accent" />

            <TextView
                style="@style/TextAppearance.Nimbus.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/tabs_new_tab"
                android:textColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNewPrivate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s">

            <ImageView
                android:layout_width="@dimen/bottom_icon_size"
                android:layout_height="@dimen/bottom_icon_size"
                android:contentDescription="@string/action_new_private_tab"
                android:src="@drawable/ic_private"
                android:tint="@color/private_accent" />

            <TextView
                style="@style/TextAppearance.Nimbus.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/tabs_new_private"
                android:textColor="@color/private_accent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>