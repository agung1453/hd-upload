<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "New bookmark" dialog. Inflated with inflate() so it is not
     part of the activity's ViewBinding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xl">

    <EditText
        android:id="@+id/etBookmarkTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/bookmarks_add_field_title"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/etBookmarkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/bookmarks_add_field_url"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/text_body" />

</LinearLayout>