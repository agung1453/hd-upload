<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="nimbus.db" />
        <include
            domain="sharedpref"
            path="nimbus_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="nimbus.db" />
        <include
            domain="sharedpref"
            path="nimbus_prefs.xml" />
    </device-transfer>
</data-extraction-rules>